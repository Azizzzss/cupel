{
  "uid": "cupel-network",
  "title": "Cupel — network",
  "tags": [
    "cupel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Finalised epoch",
      "description": "The claim of this mode. Two thirds of the stake has to agree, and no single node holds two thirds — so a number that climbs here is three clients agreeing, not one client asserting.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(beacon_finalized_epoch)",
          "legendFormat": "finalised"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Clients disagreeing",
      "description": "The gap between the furthest-ahead and furthest-behind client. One slot is scrape skew, not disagreement: the three are scraped independently every five seconds and a slot lasts six, so a sample will regularly catch one of them mid-slot. A gap that persists at two or more means three implementations built different chains from the same blocks, which is the most interesting failure this lab can produce.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(beacon_head_slot) - min(beacon_head_slot)",
          "legendFormat": "slots apart"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Head slot, per consensus client",
      "description": "Three lines that should sit exactly on top of one another.",
      "gridPos": {
        "h": 5,
        "w": 14,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "beacon_head_slot",
          "legendFormat": "{{client}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Justified and finalised",
      "description": "Justification comes first and finality follows it by an epoch. A justified epoch that stops climbing means participation has fallen below two thirds — usually one validator client that is not running.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "beacon_current_justified_epoch",
          "legendFormat": "{{client}} justified"
        },
        {
          "refId": "B",
          "expr": "beacon_finalized_epoch",
          "legendFormat": "{{client}} finalised"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Execution head, per node",
      "description": "Blocks come from beacon-chain proposers, so these follow the slots above with the empty ones skipped.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "chain_head_block",
          "legendFormat": "{{node}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Consensus peers",
      "description": "Each client names this metric differently and counts it differently: Lighthouse and Teku report a live connection count, Prysm reports its own peer registry and can show zero while it is demonstrably gossiping — compare it against the head slot above before believing it. Shown as each client sees itself, because papering over that would hide exactly the kind of difference this mode exists to surface.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "libp2p_peers or p2p_peer_count{state=\"Connected\"}",
          "legendFormat": "{{client}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Execution peers, found through the bootnode",
      "description": "Two each: the nodes discovered one another, having been told only where the bootnode is.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "p2p_peers",
          "legendFormat": "{{node}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    }
  ]
}
