{
  "uid": "cupel-gateway",
  "title": "Cupel — gateway",
  "tags": ["cupel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Upstreams answering",
      "description": "Drops to zero the moment every node stops responding. This is the panel to look at first.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cupel_gateway_upstream_up)",
          "legendFormat": "up"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "Answered, failed, and refused because no upstream could serve them.",
      "gridPos": { "h": 5, "w": 12, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cupel_gateway_requests_ok_total[1m])",
          "legendFormat": "ok"
        },
        {
          "refId": "B",
          "expr": "rate(cupel_gateway_requests_failed_total[1m])",
          "legendFormat": "failed"
        },
        {
          "refId": "C",
          "expr": "rate(cupel_gateway_requests_rejected_total[1m])",
          "legendFormat": "rejected"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "rejected" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Share of requests answered from memory without touching a node. Only provably immutable answers are cached.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "cupel_gateway_cache_hits_total / clamp_min(cupel_gateway_cache_hits_total + cupel_gateway_cache_misses_total, 1)",
          "legendFormat": "hit ratio"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Upstream health",
      "description": "One line per node. A gap here is a node that was out of rotation.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "cupel_gateway_upstream_up",
          "legendFormat": "{{upstream}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Traffic by method",
      "description": "Which calls the clients are actually making.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, rate(cupel_gateway_method_total[1m]))",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Forwarded and failed, per upstream",
      "description": "Forwarded counts every request sent on; errors counts those that failed at the transport rather than returning a JSON-RPC error.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 11 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cupel_gateway_upstream_forwarded_total[1m])",
          "legendFormat": "{{upstream}} forwarded"
        },
        {
          "refId": "B",
          "expr": "rate(cupel_gateway_upstream_errors_total[1m])",
          "legendFormat": "{{upstream}} errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    }
  ]
}
