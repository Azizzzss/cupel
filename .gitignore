/target
**/*.rs.bk

# The Engine API secret is generated on first run, never committed.
config/genesis/jwt.hex

# The devnet: validator keys, a beacon state stamped with the moment it was made,
# and a JWT. None of it means anything a day later, and `cupel network init`
# rebuilds all of it in under a minute.
config/network/

# node / explorer
node_modules/
.next/
dist/
.env
.env.local

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/

# chain data
data/
*.db
\n
# The control room's dependencies and build output. `dist` is committed once the
# binary embeds it; until then it is a build artefact like any other.
ui/node_modules/
ui/dist/
