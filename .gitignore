/target
**/*.rs.bk

# The Engine API secret is generated on first run, never committed.
config/genesis/jwt.hex

# The devnet: validator keys, a beacon state stamped with the moment it was made,
# and a JWT. None of it means anything a day later, and `cupel network init`
# rebuilds all of it in under a minute.
config/network/

# node / explorer
node_modules/
.next/
dist/
.env
.env.local

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/

# chain data
data/
*.db
\n
# The control room's dependencies. `ui/dist` is deliberately *not* ignored: it
# is compiled into the binary, so committing it is what lets `cargo build`
# produce a working control room without a JavaScript toolchain — the same
# reason the contracts' bytecode is committed. CI rebuilds it and fails on a
# difference, so it cannot go stale unnoticed.
ui/node_modules/
